# --- Backend (tuỳ chọn) ---
# Khuyên dùng vercel.json rewrite /api → Render; không cần VITE_API_BASE_URL
# VITE_API_BASE_URL=https://your-service.onrender.com

# --- Firebase project: datt-04 ---
# Console: https://console.firebase.google.com → datt-04 → ⚙ Project settings → Your apps → Web app → Config
VITE_FIREBASE_PROJECT_ID=datt-04
VITE_FIREBASE_AUTH_DOMAIN=datt-04.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=datt-04.firebasestorage.app
VITE_FIREBASE_API_KEY=paste_from_firebase_console
VITE_FIREBASE_MESSAGING_SENDER_ID=paste_from_firebase_console
VITE_FIREBASE_APP_ID=paste_from_firebase_console
VITE_FIREBASE_MEASUREMENT_ID=paste_if_using_analytics

# Local: copy thành client/.env.local
# Vercel: Settings → Environment Variables → Production + Preview → Redeploy

# Authorized domains (Authentication → Settings): thêm *.vercel.app hoặc domain cụ thể
# Ví dụ: to-do-list-khaki-alpha-95.vercel.app, to-do-list.vercel.app
