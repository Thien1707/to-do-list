# URL gốc backend (KHÔNG có /api ở cuối) — service Render của BẠN
# Kiểm tra: mở https://<host>/api/health phải trả JSON { "success": true, ... }
# VITE_API_BASE_URL=https://your-service.onrender.com

# Cách 1 (khuyên dùng trên Vercel): sửa client/vercel.json → destination trùng URL Render
# Cách 2: set VITE_API_BASE_URL trên Vercel Environment + redeploy client

# Firebase (hiện hardcode trong src/user/config/firebase.js — chỉ dùng khi refactor sau)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
