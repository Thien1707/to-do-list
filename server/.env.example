# Server (Render tự inject PORT — không cần set PORT=3000 trên dashboard)
PORT=3000
NODE_ENV=development

# MySQL — Render Web Service KHÔNG có MySQL sẵn: tạo MySQL bên ngoài (Aiven, PlanetScale, Railway, …)
# rồi dán host/user/pass vào Environment trên Render.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=task_manager_db
# SSL: trên Render để true (hoặc bỏ trống — mặc định bật SSL khi chạy cloud)
DB_SSL=true
# DB_HOST phải là hostname PUBLIC (không dùng localhost / IP máy nhà / *.internal)
# Mở firewall MySQL: cho phép kết nối từ internet hoặc IP outbound của Render (Static Outbound IP)

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unified Vite client (Vercel) — user + /admin on same origin
CLIENT_URL=http://localhost:5173
# URL production Vercel (domain chính, không bắt buộc nếu ALLOW_VERCEL_ORIGINS cho *.vercel.app)
# CLIENT_URL=https://to-do-list.vercel.app
# Thêm origin khác, cách nhau bởi dấu phẩy:
# CORS_EXTRA_ORIGINS=https://to-do-list-alme0dj4d-thien1707s-projects.vercel.app
# ALLOW_VERCEL_ORIGINS=false  # mặc định cho phép mọi https *.vercel.app
# Optional legacy aliases (same URL when using unified client/)
# USER_FRONTEND_URL=http://localhost:5173
# ADMIN_FRONTEND_URL=http://localhost:5173

# Default admin seed (first boot)
ADMIN_DEFAULT_EMAIL=admin@taskmanager.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email (optional, for scheduler reminders)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
