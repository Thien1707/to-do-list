# Server
PORT=3000
NODE_ENV=development

# MySQL (Render: use internal DB URL / credentials from dashboard)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=task_manager_db

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production

# Unified Vite client (Vercel) — user + /admin on same origin
CLIENT_URL=http://localhost:5173
# Optional legacy aliases (same URL when using unified client/)
# USER_FRONTEND_URL=http://localhost:5173
# ADMIN_FRONTEND_URL=http://localhost:5173

# Default admin seed (first boot)
ADMIN_DEFAULT_EMAIL=admin@taskmanager.com
ADMIN_DEFAULT_PASSWORD=Admin@123

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email (optional, for scheduler reminders)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
